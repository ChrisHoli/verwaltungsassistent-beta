# Kopieren nach .env und anpassen. .env nie ins Repo.

# Name, unter dem der Bot in Delta Chat erscheint
MOMO_NAME=Momo

# chatmail-Server für das Bot-Konto (kostenlos, ohne Telefonnummer)
MOMO_CHATMAIL_QR=dcaccount:nine.testrun.org

# Optional: nur diese Delta-Chat-Adressen dürfen sich koppeln (Komma getrennt).
# Leer = wer den Einladungs-QR zuerst verschlüsselt nutzt, wird Besitzer.
MOMO_BESITZER_ADRESSEN=

# Antworten zusätzlich als Sprachnachricht: immer | nie
MOMO_VORLESEN=immer
# Zuhören (Sprachnachrichten, lokal): tiny | base | small (Standard, braucht ~700 MB beim Zuhören)
MOMO_WHISPER=small
# Absender für Antwortbriefe (sonst fragt Momo einmal danach): Name|Straße Nr|PLZ Ort
MOMO_ABSENDER=

# KI: keine | mistral | claude-abo
MOMO_KI=keine
# Leer = Standard des Anbieters (mistral-medium-latest bzw. sonnet)
MOMO_KI_MODELL=

# Mistral (EU): Schlüssel aus Mistral Studio (console.mistral.ai)
MISTRAL_API_KEY=

# Claude-Abo (nur zum Testen): Token aus `claude setup-token`.
# Bild dafür mit MIT_CLAUDE=1 bauen (siehe docker-compose.yml).
CLAUDE_CODE_OAUTH_TOKEN=

# Speicherort: ordner (lokal im Datenordner) | rclone (Cloud)
MOMO_ABLAGE=ordner
MOMO_ABLAGE_ZIEL=/daten/ablage

# Beispiel Nextcloud über rclone (MOMO_ABLAGE=rclone, MOMO_ABLAGE_ZIEL=nextcloud:)
# Am besten eigener Nextcloud-Benutzer mit App-Passwort. Das Passwort verschleiert rclone:
#   docker compose run --rm momo sh -c 'read -r p; echo "$p" | rclone obscure -'
#RCLONE_CONFIG_NEXTCLOUD_TYPE=webdav
#RCLONE_CONFIG_NEXTCLOUD_VENDOR=nextcloud
#RCLONE_CONFIG_NEXTCLOUD_URL=https://cloud.example.org/remote.php/dav/files/momo
#RCLONE_CONFIG_NEXTCLOUD_USER=momo
#RCLONE_CONFIG_NEXTCLOUD_PASS=
# Google Drive, iCloud Drive, OneDrive, Dropbox: einmal `docker compose run --rm momo rclone config`
# (legt /daten/rclone.conf an), dann z. B. MOMO_ABLAGE_ZIEL=drive:Momo
