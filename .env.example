# Kopieren nach .env und anpassen. .env nie ins Repo.

# Name, unter dem der Bot in Delta Chat erscheint
MOMO_NAME=Momo

# Messenger: deltachat (empfohlen) | signal | telegram   – am einfachsten mit ./einrichten.sh
#   deltachat  Ende-zu-Ende verschlüsselt, keine Telefonnummer, Mini-App im Chat
#   signal     Ende-zu-Ende verschlüsselt; Momo braucht eine eigene Nummer (verknüpftes Gerät), Dienst „signal“
#   telegram   Bot von @BotFather; Telegram kann mitlesen (keine Ende-zu-Ende-Verschlüsselung bei Bots)
#   WhatsApp geht nicht: nur über Metas Business-Schnittstelle (Firmenkonto, öffentlicher Server, Vorlagen, Kosten)
MOMO_MESSENGER=deltachat

# Delta Chat: chatmail-Server für das Bot-Konto (kostenlos, ohne Telefonnummer)
MOMO_CHATMAIL_QR=dcaccount:nine.testrun.org
# Telegram: Zugangsschlüssel von @BotFather
MOMO_TELEGRAM_TOKEN=
# Signal: Momos eigene Nummer; der Dienst „signal“ startet nur mit diesem Profil
MOMO_SIGNAL_NUMMER=
#COMPOSE_PROFILES=signal

# Optional: nur diese Kontakte dürfen sich koppeln (Komma getrennt): Delta-Chat-Adresse, Signal-Telefonnummer
# (+49…) oder Telegram-@Benutzername. Leer = wer die Einladung zuerst nutzt, wird Besitzer
# (Delta Chat: verschlüsselt; Telegram: nur mit dem Code aus dem Einladungslink; Signal: wer zuerst schreibt).
MOMO_BESITZER_ADRESSEN=

# Antworten zusätzlich als Sprachnachricht: immer | nie
MOMO_VORLESEN=immer
# Sprechtempo in Prozent: 100 = ruhig (Standard), 150 = anderthalbmal so schnell (50 bis 250)
MOMO_SPRECHTEMPO=100
# Zuhören (Sprachnachrichten, lokal): tiny | base | small (Standard, braucht ~700 MB beim Zuhören)
MOMO_WHISPER=small
# Wer Momo betreibt (steht im Datenschutz-Hinweis, z. B. ein Vorname oder ein Verein)
MOMO_BETREIBER=
# Nach so vielen Tagen löscht Momo den Chat bei sich (Fotos, Sprachnachrichten). Briefe im Speicherort bleiben.
MOMO_AUFHEBEN_TAGE=30
# Absender für Antwortbriefe (sonst fragt Momo einmal danach): Name|Straße Nr|PLZ Ort
MOMO_ABSENDER=

# KI: jede ist möglich. Nur Text geht an die KI, nie Fotos.
#   mistral            Mistral (EU, Hauptweg)            Schlüssel: MISTRAL_API_KEY oder MOMO_KI_SCHLUESSEL
#   openai             OpenAI                            Schlüssel: OPENAI_API_KEY, Modell nötig
#   gemini             Google Gemini                     Schlüssel: GEMINI_API_KEY, Modell nötig
#   anthropic          Claude über die API               Schlüssel: ANTHROPIC_API_KEY (Standard claude-opus-5-5)
#   openrouter / groq  Vermittler für viele Modelle      Schlüssel: OPENROUTER_API_KEY / GROQ_API_KEY
#   ollama             lokal, nichts verlässt das Haus   Modell nötig, z. B. llama3.1 (MOMO_KI_ADRESSE anpassen)
#   openai-kompatibel  jeder andere Dienst oder Server mit /chat/completions (LM Studio, vLLM, IONOS, Scaleway …)
#                      braucht MOMO_KI_ADRESSE, z. B. https://anbieter.example/v1
#   befehl             jedes Programm: Text rein über stdin, Antwort über stdout (MOMO_KI_BEFEHL)
#   claude-abo         Claude-Abo, nur zum Testen
#   mistral-vibe       Mistral über ein Le-Chat-Abo (Mistral Vibe)   Schlüssel: MOMO_VIBE_SCHLUESSEL, Bild mit MIT_VIBE=1
#   keine              ohne KI (Momo antwortet nur mit festen Sätzen)
MOMO_KI=keine
# Leer = Standard des Anbieters (sofern es einen gibt)
MOMO_KI_MODELL=
# Gemeinsam für alle: Schlüssel und Adresse (überschreiben die Voreinstellung)
MOMO_KI_SCHLUESSEL=
MOMO_KI_ADRESSE=
# Nur für MOMO_KI=befehl, z. B.: ollama run llama3.1
MOMO_KI_BEFEHL=
# Nur für MOMO_KI=anthropic: low | medium | high
MOMO_KI_AUFWAND=

# E-Mail (optional): Momo legt E-Mails mit dem PDF bei den Entwürfen im Postfach der Person ab.
# Am besten ein App-Passwort anlegen. IMAP/SMTP als host:port (993 = SSL, 143 = STARTTLS; 465 = SSL, 587 = STARTTLS).
MOMO_MAIL_ADRESSE=
MOMO_MAIL_PASSWORT=
MOMO_MAIL_IMAP=
MOMO_MAIL_SMTP=
# ja = Momo darf nach ausdrücklicher Bestätigung („Ja, abschicken“ als Antwort auf genau diese E-Mail) abschicken
MOMO_MAIL_SENDEN=nein

# Mistral (EU): Schlüssel aus Mistral Studio (console.mistral.ai)
MISTRAL_API_KEY=

# Claude-Abo (nur zum Testen): Token aus `claude setup-token`.
# Bild dafür mit MIT_CLAUDE=1 bauen (siehe docker-compose.yml).
CLAUDE_CODE_OAUTH_TOKEN=

# Mistral Vibe (Le-Chat-Abo Pro/Team): Schlüssel aus console.mistral.ai → Code → Vibe CLI.
# Bild dafür mit MIT_VIBE=1 bauen; Vibe läuft ohne jedes Werkzeug, nur als Textantwort.
MOMO_VIBE_SCHLUESSEL=
#MIT_VIBE=1

# Speicherort: ordner (lokal im Datenordner) | rclone (Cloud)
MOMO_ABLAGE=ordner
MOMO_ABLAGE_ZIEL=/daten/ablage

# Beispiel Nextcloud über rclone (MOMO_ABLAGE=rclone, MOMO_ABLAGE_ZIEL=nextcloud:)
# Am besten eigener Nextcloud-Benutzer mit App-Passwort. Das Passwort verschleiert rclone:
#   docker compose run --rm momo sh -c 'read -r p; echo "$p" | rclone obscure -'
#RCLONE_CONFIG_NEXTCLOUD_TYPE=webdav
#RCLONE_CONFIG_NEXTCLOUD_VENDOR=nextcloud
#RCLONE_CONFIG_NEXTCLOUD_URL=https://cloud.example.org/remote.php/dav/files/momo
#RCLONE_CONFIG_NEXTCLOUD_USER=momo
#RCLONE_CONFIG_NEXTCLOUD_PASS=
# Google Drive, iCloud Drive, OneDrive, Dropbox: einmal `docker compose run --rm momo rclone config`
# (legt /daten/rclone.conf an), dann z. B. MOMO_ABLAGE_ZIEL=drive:Momo
