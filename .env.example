# Kopieren nach .env und anpassen. .env nie ins Repo.

# Name, unter dem der Bot in Delta Chat erscheint
MOMO_NAME=Momo

# chatmail-Server für das Bot-Konto (kostenlos, ohne Telefonnummer)
MOMO_CHATMAIL_QR=dcaccount:nine.testrun.org

# Optional: nur diese Delta-Chat-Adressen dürfen sich koppeln (Komma getrennt).
# Leer = wer den Einladungs-QR zuerst verschlüsselt nutzt, wird Besitzer.
MOMO_BESITZER_ADRESSEN=

# Antworten zusätzlich als Sprachnachricht: immer | nie
MOMO_VORLESEN=immer

# KI: keine | mistral | claude-abo
MOMO_KI=keine
# Leer = Standard des Anbieters (mistral-medium-latest bzw. sonnet)
MOMO_KI_MODELL=

# Mistral (EU): Schlüssel aus Mistral Studio (console.mistral.ai)
MISTRAL_API_KEY=

# Claude-Abo (nur zum Testen): Token aus `claude setup-token`.
# Bild dafür mit MIT_CLAUDE=1 bauen (siehe docker-compose.yml).
CLAUDE_CODE_OAUTH_TOKEN=

# Speicherort (ab V4 auch rclone): ordner
MOMO_ABLAGE=ordner
MOMO_ABLAGE_ZIEL=/daten/ablage
